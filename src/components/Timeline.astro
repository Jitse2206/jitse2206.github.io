---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

export interface TijdlijnItem {
  label: string;
  titel: string;
  details?: string[];
  href?: string;
  beeld?: { src: ImageMetadata; alt: string };
}

interface Props {
  items: TijdlijnItem[];
  wisselend?: boolean;
}

const { items, wisselend = false } = Astro.props;
---

<ol class:list={['tijdlijn', { wisselend }]}>
  {items.map((item) => {
    const Halte = item.href ? 'a' : 'div';

    return (
      <li class:list={['tijdlijn-item', { 'met-beeld': item.beeld }]}>
        <Halte class="halte" href={item.href}>
          <div class="halte-tekst">
            <p class="label">{item.label}</p>
            <h3 class="titel">{item.titel}</h3>
            {item.details && item.details.length > 0 && (
              <p class="details">
                {item.details.map((regel, index) => (
                  <>
                    {index > 0 && <br />}
                    {regel}
                  </>
                ))}
              </p>
            )}
          </div>
          {item.beeld && (
            <Picture
              class="halte-beeld"
              src={item.beeld.src}
              alt={item.beeld.alt}
              widths={[360, 560, 720]}
              sizes="(min-width: 900px) 270px, 92vw"
              formats={['avif', 'webp']}
            />
          )}
          <span class="bolletje" aria-hidden="true"></span>
        </Halte>
      </li>
    );
  })}
</ol>

<style>
  .tijdlijn {
    position: relative;
    margin: 0 0 0 0.625rem;
    padding: 0;
    border-left: 3px dashed color-mix(in srgb, var(--creme) 70%, transparent);
    list-style: none;
  }

  .tijdlijn-item {
    padding-bottom: 1.75rem;
  }

  .tijdlijn-item:last-child {
    padding-bottom: 0;
  }

  .halte {
    position: relative;
    display: block;
    padding-left: 1.625rem;
    color: var(--creme);
    text-decoration: none;
  }

  a.halte:hover .titel {
    color: var(--olijf-licht);
  }

  .bolletje {
    position: absolute;
    top: 0.2rem;
    left: -0.75rem;
    width: 1.25rem;
    height: 1.25rem;
    border: 4px solid var(--creme);
    border-radius: 50%;
    background: var(--olijf);
  }

  .met-beeld .bolletje {
    top: 5.25rem;
  }

  .label {
    margin: 0;
    color: var(--olijf-licht);
    font-size: 0.875rem;
  }

  .titel {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .details {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .met-beeld .titel {
    margin-bottom: 0.625rem;
    font-size: 1.5rem;
  }

  .met-beeld .details {
    display: none;
  }

  .halte :global(.halte-beeld),
  .halte :global(.halte-beeld img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 18px;
  }

  .halte :global(.halte-beeld img) {
    border: 6px solid var(--creme);
  }

  .tijdlijn-item:nth-child(even) .halte :global(.halte-beeld img) {
    border-color: var(--olijf);
  }

  @media (min-width: 700px) {
    .tijdlijn {
      margin-left: 0.75rem;
      border-left-width: 4px;
    }

    .tijdlijn-item {
      padding-bottom: 2.125rem;
    }

    .halte {
      padding-left: 2.5rem;
    }

    .bolletje {
      left: -0.8rem;
      width: 1.375rem;
      height: 1.375rem;
    }

    .label {
      font-size: 0.9375rem;
    }

    .titel {
      font-size: 1.5rem;
    }

    .details {
      margin-top: 0.25rem;
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 900px) {
    .wisselend {
      display: flex;
      flex-direction: column;
      gap: 4.5rem;
      margin: 0;
      border-left: 0;
    }

    .wisselend::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      margin-left: -2px;
      border-left: 4px dashed color-mix(in srgb, var(--creme) 70%, transparent);
    }

    .wisselend .tijdlijn-item {
      width: 50%;
      padding: 0;
    }

    .wisselend .tijdlijn-item:nth-child(even) {
      margin-left: 50%;
    }

    .wisselend .halte {
      display: flex;
      gap: 1.75rem;
      align-items: center;
      justify-content: flex-end;
      padding: 0 2.75rem 0 0;
    }

    .wisselend .tijdlijn-item:nth-child(even) .halte {
      flex-direction: row-reverse;
      padding: 0 0 0 2.75rem;
    }

    .wisselend .halte-tekst {
      flex: 1 1 10rem;
      text-align: right;
    }

    .wisselend .tijdlijn-item:nth-child(even) .halte-tekst {
      text-align: left;
    }

    .wisselend .label {
      font-size: 1rem;
    }

    .wisselend .titel {
      margin: 0;
      font-size: 1.875rem;
      line-height: 1.1;
    }

    .wisselend .details {
      display: block;
      margin-top: 0.375rem;
    }

    .wisselend .halte :global(.halte-beeld),
    .wisselend .halte :global(.halte-beeld img) {
      flex: none;
      width: 16.875rem;
      border-radius: 22px;
    }

    .wisselend .halte :global(.halte-beeld img) {
      border-width: 8px;
    }

    .wisselend .bolletje {
      top: 50%;
      right: -0.9375rem;
      left: auto;
      width: 1.875rem;
      height: 1.875rem;
      margin-top: -0.9375rem;
    }

    .wisselend .tijdlijn-item:nth-child(even) .bolletje {
      right: auto;
      left: -0.9375rem;
    }
  }
</style>
