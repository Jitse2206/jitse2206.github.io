---
interface Props {
  secties: { id: string; label: string }[];
}

const { secties } = Astro.props;
---

<nav class="procesnav" aria-labelledby="proces-titel">
  <p id="proces-titel" class="proces-titel">Proces</p>
  <ol>
    {secties.map((sectie) => (
      <li>
        <a href={`#${sectie.id}`} data-sectie={sectie.id}>
          <span class="stip" aria-hidden="true"></span>
          {sectie.label}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.procesnav [data-sectie]');
  const secties = [...links]
    .map((link) => document.getElementById(link.dataset.sectie ?? ''))
    .filter((sectie): sectie is HTMLElement => sectie !== null);

  const markeerActief = (id: string) => {
    links.forEach((link) => {
      const actief = link.dataset.sectie === id;
      link.classList.toggle('actief', actief);
      if (actief) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const zichtbaar = entries.find((entry) => entry.isIntersecting);
      if (zichtbaar) markeerActief(zichtbaar.target.id);
    },
    { rootMargin: '-35% 0px -60% 0px' }
  );

  secties.forEach((sectie) => observer.observe(sectie));
</script>

<style>
  .procesnav {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-inline: -1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--creme) 25%, transparent);
    background: var(--bordeaux);
  }

  .proces-titel {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  ol {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  a {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: color-mix(in srgb, var(--creme) 88%, transparent);
    font-size: 0.9375rem;
    white-space: nowrap;
    text-decoration: none;
  }

  .stip {
    flex: none;
    width: 1rem;
    height: 1rem;
    border: 3px solid color-mix(in srgb, var(--creme) 60%, transparent);
    border-radius: 50%;
  }

  a:hover {
    color: var(--olijf-licht);
  }

  a.actief {
    color: var(--wit);
    font-weight: 700;
  }

  a.actief .stip {
    border-color: var(--creme);
    background: var(--olijf);
  }

  @media (min-width: 700px) {
    .procesnav {
      margin-inline: -2rem;
      padding-inline: 2rem;
    }
  }

  @media (min-width: 900px) {
    .procesnav {
      top: 1.5rem;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
    }

    .proces-titel {
      position: static;
      width: auto;
      height: auto;
      margin: 0 0 1.125rem;
      overflow: visible;
      clip-path: none;
      color: var(--olijf-licht);
      font-size: 0.8125rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    ol {
      flex-direction: column;
      gap: 1.375rem;
      margin-left: 0.4375rem;
      padding-block: 0.25rem;
      border-left: 3px dashed color-mix(in srgb, var(--creme) 50%, transparent);
      overflow: visible;
    }

    a {
      gap: 0.875rem;
      margin-left: -0.5625rem;
      font-size: 1rem;
    }

    .stip {
      background: var(--bordeaux);
    }
  }
</style>
