---
interface Props {
  kanteling?: number;
  class?: string;
}

const { kanteling = 0, class: className } = Astro.props;
---

<div class:list={['gescheurd-papier', className]} style={`--kanteling: ${kanteling}deg`}>
  <slot />
</div>

<style>
  .gescheurd-papier {
    padding: 1.625rem 1.125rem 1.875rem;
    background-color: var(--papier);
    background-image: radial-gradient(color-mix(in srgb, var(--inkt) 12%, transparent) 1px, transparent 1.5px);
    background-size: 7px 7px;
    color: var(--inkt);
    font-family: var(--font-hand);
    font-size: 1.375rem;
    line-height: 1.4;
    clip-path: polygon(0 3%, 4% 0, 9% 2%, 15% 0, 22% 3%, 30% 1%, 38% 3%, 46% 0, 55% 2%, 63% 0, 71% 3%, 80% 1%, 88% 3%, 95% 0, 100% 2%, 99% 50%, 100% 97%, 94% 100%, 86% 98%, 78% 100%, 70% 97%, 61% 100%, 52% 98%, 44% 100%, 35% 97%, 27% 100%, 18% 98%, 9% 100%, 0 97%, 1% 50%);
    transform: rotate(var(--kanteling));
  }
</style>
